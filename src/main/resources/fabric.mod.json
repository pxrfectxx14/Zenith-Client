		{
			"config": "zenith-client.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.6",
		"java": ">=21",
		"fabric-api": "*"
